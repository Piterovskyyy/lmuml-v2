# Local development only. Production uses separate configuration and credentials.
LMUML_DB_NAME=lmuml_dev
LMUML_DB_USER=lmuml_dev_admin
LMUML_DB_PASSWORD=
LMUML_DB_PORT=5433

# Separate application role. Do not use the database administrator in the API.
LMUML_APP_DB_USER=lmuml_app
LMUML_APP_DB_PASSWORD=

# Schema owner used only by the explicit migration command.
LMUML_MIGRATION_DB_USER=lmuml_migrator
LMUML_MIGRATION_DB_PASSWORD=

# Restricted data writer used only by the explicit offline import command.
LMUML_IMPORT_DB_USER=lmuml_importer
LMUML_IMPORT_DB_PASSWORD=

# Optional provider client. Enabling it does not schedule API requests.
LMUML_API_FOOTBALL_ENABLED=false
LMUML_API_FOOTBALL_API_KEY=

# Optional administrator login. Local setup can supply it from .local/admin-password.txt.
LMUML_ADMIN_PASSWORD_HASH=

# Enable player registration and login for local development.
LMUML_PLAYER_AUTH_ENABLED=true

# Optional catalogue cache with the local Compose cache profile.
LMUML_CATALOG_CACHE_ENABLED=false
LMUML_REDIS_PORT=6380

# For local password-reset email, use scripts/run-backend.mjs --local-mail with Mailpit.
