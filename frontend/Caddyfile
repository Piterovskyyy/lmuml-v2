{
	admin off
	auto_https disable_redirects
	skip_install_trust
}

{$LMUML_PUBLIC_SITE:https://localhost} {
	tls internal
	encode zstd gzip
	root * /srv

	@api path /api /api/*
	handle @api {
		reverse_proxy backend:8080 {
			# Caddy replaces the three standard X-Forwarded headers at this edge.
			header_up -Forwarded
			header_up -X-Forwarded-Port
			header_up -X-Forwarded-Prefix
		}
	}

	@management path /actuator /actuator/*
	handle @management {
		respond 404
	}

	handle /assets/* {
		file_server
	}

	handle {
		try_files {path} /index.html
		file_server
	}
}
